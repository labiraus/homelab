{
  "name": "homelab",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.9.0": {
      "enableNonRootDocker": "true",
      "moby": "true"
    },
    "ghcr.io/devcontainers/features/terraform:1": {},
    "ghcr.io/goldsam/dev-container-features/flux2": {},
    "ghcr.io/audacioustux/devcontainers/k9s:1": {},
    "ghcr.io/audacioustux/devcontainers/cilium:1": {},
    "ghcr.io/rio/features/skaffold:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "minikube": "none"
    },
    "ghcr.io/devcontainers/features/node": {
      "version": "24"
    }
  },
  "mounts": [
    {
      "type": "bind",
      "source": "${localWorkspaceFolder}/.devcontainer/kubeconfig",
      "target": "/home/vscode/.kube/config"
    },
    {
      "type": "bind",
      "source": "${localWorkspaceFolder}/.devcontainer/hosts",
      "target": "/etc/hosts"
    },
    {
      "type": "bind",
      "source": "${localWorkspaceFolder}/.devcontainer/ssh",
      "target": "/home/vscode/.ssh"
    },
    {
      "type": "bind",
      "source": "${localWorkspaceFolder}/.devcontainer/.env",
      "target": "/home/vscode/.env"
    },
    {
      "type": "bind",
      "source": "${localWorkspaceFolder}/.devcontainer/.bashrc",
      "target": "/home/vscode/.bashrc.devcontainer"
    },
    {
      "source": "${localWorkspaceFolder}/.devcontainer/config.toml",
      "target": "/tmp/codex-config.toml",
      "type": "bind"
    },
    {
      "type": "bind",
      "source": "${localWorkspaceFolder}/plugin-cache",
      "target": "/home/vscode/terraform-plugin-cache"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "hashicorp.terraform",
        "openai.chatgpt",
        "GitHub.copilot-chat",
        "ms-vscode.makefile-tools",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "tim-koehler.helm-intellisense",
        "redhat.vscode-yaml",
        "fluxcd.flux",
        "ckolkman.vscode-postgres",
        "bierner.markdown-mermaid"
      ]
    }
  },
  "containerEnv": {
    "TF_PLUGIN_CACHE_DIR": "/home/vscode/terraform-plugin-cache"
  },
  "runArgs": [
    "--env-file",
    ".devcontainer/.env"
  ],
  "postCreateCommand": {
    "codex-config": "mkdir -p /home/vscode/.codex && cp /tmp/codex-config.toml /home/vscode/.codex/config.toml && chown vscode:vscode /home/vscode/.codex/config.toml && chmod 600 /home/vscode/.codex/config.toml",
    "git": "git config --global --add safe.directory /workspaces/homelab",
    "scripts": "find . -type d -name node_modules -prune -o -type f -path '*/scripts/*.sh' -exec chmod +x {} + || true",
    "terraform.sh": "chmod +x ./bin/tf",
    "ssh": "[ -d /home/vscode/.ssh ] && (sudo chown -R vscode:vscode /home/vscode/.ssh 2>/dev/null || true) && chmod 700 /home/vscode/.ssh && find /home/vscode/.ssh -maxdepth 1 -type f -exec chmod 600 {} + 2>/dev/null || true",
    "ui-deps": "cd /workspaces/homelab/apps/ui && npm install",
    "processor-deps": "cd /workspaces/homelab/apps/processor && npm install"
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true
}
