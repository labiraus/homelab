[Unit]
Description=SeaweedFS private S3 storage
Wants=network-online.target
After=network-online.target {{ seaweedfs_mount_unit.stdout }}
RequiresMountsFor={{ seaweedfs_mount }}
BindsTo={{ seaweedfs_mount_unit.stdout }}
AssertPathIsMountPoint={{ seaweedfs_mount }}

[Service]
Type=simple
User={{ seaweedfs_service_user }}
Group={{ seaweedfs_service_group }}
WorkingDirectory=/etc/seaweedfs
ExecStartPre=/usr/bin/mountpoint -q {{ seaweedfs_mount }}
ExecStart=/usr/local/bin/weed server -ip=127.0.0.1 -ip.bind=127.0.0.1 -dir={{ seaweedfs_volume_dir }} -master.dir={{ seaweedfs_metadata_dir }}/master -master.volumeSizeLimitMB=1024 -master.telemetry=false -volume.max=0 -filer -s3 -s3.ip.bind=127.0.0.1 -s3.port={{ seaweedfs_s3_port }} -s3.config=/etc/seaweedfs/s3.json -s3.port.iceberg=0 -s3.port.lance=0
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ seaweedfs_volume_dir }} {{ seaweedfs_metadata_dir }}

[Install]
WantedBy=multi-user.target
