# Generated locally. Apply only after the migration validation gates pass.
apiVersion: v1
kind: Secret
metadata:
  name: documents-s3-credentials
  namespace: homelab
type: Opaque
stringData:
  accessKey: {{ lookup('ansible.builtin.env', 'SEAWEED_DOCUMENTS_ACCESS_KEY') | to_json }}
  secretKey: {{ lookup('ansible.builtin.env', 'SEAWEED_DOCUMENTS_SECRET_KEY') | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: cnpg-seaweedfs-s3
  namespace: data
type: Opaque
stringData:
  accessKey: {{ lookup('ansible.builtin.env', 'SEAWEED_CNPG_ACCESS_KEY') | to_json }}
  secretKey: {{ lookup('ansible.builtin.env', 'SEAWEED_CNPG_SECRET_KEY') | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: velero-s3-credentials
  namespace: velero
type: Opaque
stringData:
  cloud: {{ ('[default]\naws_access_key_id=' ~ lookup('ansible.builtin.env', 'SEAWEED_VELERO_ACCESS_KEY') ~ '\naws_secret_access_key=' ~ lookup('ansible.builtin.env', 'SEAWEED_VELERO_SECRET_KEY') ~ '\n') | to_json }}
