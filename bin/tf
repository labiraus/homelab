#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  bin/tf <action> <component> <primary_layer> [overlay_layer ...] [--no-refresh] [-- <extra terraform args>]

Actions:
  plan | apply | destroy | unlock | import | state-rm | state-list

Examples:
  ENV=lab bin/tf plan kubernetes node1
  ENV=lab bin/tf apply kubernetes node1 --no-refresh
  ENV=lab bin/tf apply kubernetes node2 -- -auto-approve
  ENV=lab bin/tf unlock kubernetes node1
  ENV=lab bin/tf import kubernetes node2 -- <address> <id>
  ENV=lab bin/tf state-rm kubernetes node2 -- <address> [address ...]
  ENV=lab bin/tf state-list kubernetes node2
EOF
}

if [[ $# -lt 3 ]]; then
  usage
  exit 1
fi

if ! command -v terraform >/dev/null 2>&1; then
  echo "Error: terraform command not found in PATH." >&2
  exit 1
fi

action="$1"
shift

case "${action}" in
  plan|apply|destroy|unlock|import|state-rm|state-list) ;;
  *)
    echo "Error: action must be one of: plan, apply, destroy, unlock, import, state-rm, state-list." >&2
    usage
    exit 1
    ;;
esac

component="$1"
shift
primary_layer="$1"
shift

overlay_layers=()
extra_tf_args=()
unlock_lock_id=""
disable_refresh=false

if [[ "${action}" == "unlock" ]]; then
  if [[ $# -gt 1 ]]; then
    echo "Error: unlock accepts at most one optional lock ID argument." >&2
    echo "Usage: bin/tf unlock <component> <primary_layer> [lock_id]" >&2
    exit 1
  fi
  if [[ $# -eq 1 ]]; then
    unlock_lock_id="$1"
  fi
else
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--no-refresh" ]]; then
      disable_refresh=true
      shift
      continue
    fi
    if [[ "$1" == "--" ]]; then
      shift
      extra_tf_args=("$@")
      break
    fi
    overlay_layers+=("$1")
    shift
  done
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/.." && pwd)"

component_dir="${repo_root}/components/${component}"
if [[ ! -d "${component_dir}" ]]; then
  echo "Error: component directory not found: ${component_dir}" >&2
  exit 1
fi

env_name="${ENV:-lab}"
workspace="${env_name}-${component}-${primary_layer}"
tfc_hostname="${TFC_HOSTNAME:-app.terraform.io}"

env_var_file="${repo_root}/etc/env/${env_name}.tfvars"
node_var_file="${repo_root}/etc/nodes/${primary_layer}.tfvars"

var_files=("${env_var_file}" "${node_var_file}")

if [[ "${action}" != "unlock" ]]; then
  for layer in "${overlay_layers[@]}"; do
    candidate_a="${repo_root}/etc/${layer}.tfvars"
    candidate_b="${repo_root}/etc/overlays/${layer}.tfvars"

    if [[ -f "${candidate_a}" ]]; then
      var_files+=("${candidate_a}")
    elif [[ -f "${candidate_b}" ]]; then
      var_files+=("${candidate_b}")
    else
      echo "Error: overlay '${layer}' not found as '${candidate_a}' or '${candidate_b}'." >&2
      exit 1
    fi
  done

  for var_file in "${var_files[@]}"; do
    if [[ ! -f "${var_file}" ]]; then
      echo "Error: tfvars file not found: ${var_file}" >&2
      exit 1
    fi
  done
fi

if [[ -z "${TFC_ORG:-}" ]]; then
  echo "Error: TFC_ORG must be set in the environment." >&2
  exit 1
fi

is_tfc_logged_in() {
  local sanitized token_var
  sanitized="${tfc_hostname//./_}"
  sanitized="${sanitized//-/_}"
  token_var="TF_TOKEN_${sanitized}"

  if [[ -n "${!token_var:-}" ]]; then
    return 0
  fi

  if [[ -f "${HOME}/.terraform.d/credentials.tfrc.json" ]] && \
     grep -q "\"${tfc_hostname}\"" "${HOME}/.terraform.d/credentials.tfrc.json"; then
    return 0
  fi

  if [[ -n "${TF_CLI_CONFIG_FILE:-}" ]] && [[ -f "${TF_CLI_CONFIG_FILE}" ]] && \
     grep -q "${tfc_hostname}" "${TF_CLI_CONFIG_FILE}"; then
    return 0
  fi

  return 1
}

if ! is_tfc_logged_in; then
  echo "Terraform Cloud credentials were not found for ${tfc_hostname}." >&2
  if [[ -t 0 && -t 1 ]]; then
    read -r -p "Run 'terraform login ${tfc_hostname}' now? [Y/n] " login_answer
    login_answer="${login_answer:-Y}"
    if [[ "${login_answer}" =~ ^[Yy]$ ]]; then
      terraform login "${tfc_hostname}"
      if ! is_tfc_logged_in; then
        echo "Error: Terraform Cloud login did not produce usable credentials." >&2
        exit 1
      fi
    else
      echo "Error: login required. Run: terraform login ${tfc_hostname}" >&2
      exit 1
    fi
  else
    echo "Error: login required. Run: terraform login ${tfc_hostname}" >&2
    exit 1
  fi
fi

export TF_IN_AUTOMATION=1
export TF_PLUGIN_CACHE_DIR="${repo_root}/plugin-cache"
mkdir -p "${TF_PLUGIN_CACHE_DIR}"

export TF_DATA_DIR="${repo_root}/.tfdata/${env_name}/${component}/${workspace}"
mkdir -p "${TF_DATA_DIR}"

cloud_tf="${component_dir}/cloud.auto.tf"
cleanup() {
  rm -f "${cloud_tf}"
}
trap cleanup EXIT INT TERM

{
  cat <<EOF
terraform {
  cloud {
    hostname     = "${tfc_hostname}"
    organization = "${TFC_ORG}"
EOF

  if [[ -n "${TFC_PROJECT:-}" ]]; then
    cat <<EOF
    project = "${TFC_PROJECT}"
EOF
  fi

  cat <<EOF
    workspaces {
      name = "${workspace}"
    }
  }
}
EOF
} > "${cloud_tf}"

terraform_var_args=()
for var_file in "${var_files[@]}"; do
  terraform_var_args+=("-var-file=${var_file}")
done

echo "Environment: ${env_name}"
echo "Component:   ${component}"
echo "Workspace:   ${workspace}"
echo "Var files:"
for var_file in "${var_files[@]}"; do
  echo "  - ${var_file}"
done

cd "${component_dir}"
if [[ "${action}" == "unlock" ]]; then
  if ! terraform_init_output="$(terraform init -upgrade=false 2>&1)"; then
    printf '%s\n' "${terraform_init_output}" >&2
    exit 1
  fi
  printf '%s\n' "${terraform_init_output}"

  lock_id="${unlock_lock_id:-${TFC_ORG}/${workspace}}"
  echo "Unlocking remote state lock ID: ${lock_id}"
  if terraform force-unlock -force "${lock_id}"; then
    echo "Remote state unlock completed."
  else
    echo "Remote unlock failed for '${lock_id}'." >&2
    if [[ -z "${unlock_lock_id}" ]]; then
      echo "Tip: re-run with explicit lock UUID from lock info:" >&2
      echo "  bin/tf unlock ${component} ${primary_layer} <lock_uuid>" >&2
    fi
    exit 1
  fi

  echo "Clearing local lock files in TF_DATA_DIR (if present)..."
  find "${TF_DATA_DIR}" -type f -name "*.lock.info" -print -delete 2>/dev/null || true
  find "${component_dir}" -maxdepth 2 -type f -name "*.lock.info" -print -delete 2>/dev/null || true
  exit 0
fi

if ! terraform_init_output="$(terraform init -upgrade 2>&1)"; then
  printf '%s\n' "${terraform_init_output}" >&2
  if grep -q "Unreadable module directory" <<< "${terraform_init_output}" && \
     grep -q "../../modules" <<< "${terraform_init_output}"; then
    cat >&2 <<EOF
Hint: this component uses a local module path (${component_dir}/../../modules).
If your Terraform Cloud workspace is configured for Remote execution, that path is outside the uploaded config archive.
Set the workspace execution mode to Local, or publish/use a remote module source.
EOF
  fi
  exit 1
fi
printf '%s\n' "${terraform_init_output}"
if [[ "${action}" == "import" ]]; then
  if [[ "${#extra_tf_args[@]}" -lt 2 ]]; then
    echo "Error: import requires <address> <id> after '--'." >&2
    echo "Usage: bin/tf import <component> <primary_layer> [overlay_layer ...] -- <address> <id>" >&2
    exit 1
  fi
  terraform_cmd=(terraform import -input=false -lock-timeout=5m)
  terraform_cmd+=("${terraform_var_args[@]}" "${extra_tf_args[@]}")
  "${terraform_cmd[@]}"
  exit 0
fi

if [[ "${action}" == "state-rm" ]]; then
  if [[ "${#extra_tf_args[@]}" -lt 1 ]]; then
    echo "Error: state-rm requires at least one <address> after '--'." >&2
    echo "Usage: bin/tf state-rm <component> <primary_layer> [overlay_layer ...] -- <address> [address ...]" >&2
    exit 1
  fi
  terraform_cmd=(terraform state rm)
  terraform_cmd+=("${extra_tf_args[@]}")
  "${terraform_cmd[@]}"
  exit 0
fi

if [[ "${action}" == "state-list" ]]; then
  terraform_cmd=(terraform state list)
  "${terraform_cmd[@]}"
  exit 0
fi

terraform_cmd=(terraform "${action}" -auto-approve -input=false -lock-timeout=5m)
if [[ "${disable_refresh}" == "true" ]]; then
  terraform_cmd+=("-refresh=false")
fi
terraform_cmd+=("${terraform_var_args[@]}" "${extra_tf_args[@]}")
"${terraform_cmd[@]}"
