FROM debian:bookworm-slim AS fetch
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
ARG TARGETARCH
RUN --mount=type=secret,id=build_ca set -eu; \
    if [ -f /run/secrets/build_ca ]; then export CURL_CA_BUNDLE=/run/secrets/build_ca; fi; \
    case "$TARGETARCH" in \
    amd64) arch=X86_64; checksum=beec9ed1c492d93db809890f16713e3556353294b823c2184ad4e891f1b2b54d ;; \
    arm64) arch=Aarch64; checksum=3d131aa888cd56da446f9c6bb460b1f0569f6c7edc74eae6193a2fe3928883ba ;; \
    *) exit 1 ;; esac; \
    curl --fail --location --proto '=https' --tlsv1.2 "https://rolesanywhere.amazonaws.com/releases/1.8.5/$arch/Linux/Amzn2023/aws_signing_helper" -o /aws_signing_helper; \
    printf '%s  /aws_signing_helper\n' "$checksum" | sha256sum -c -; chmod 0555 /aws_signing_helper
# The official Amzn2023 helper links glibc/libresolv; static has no loader.
FROM gcr.io/distroless/base-debian12:nonroot
COPY --from=fetch /aws_signing_helper /aws_signing_helper
USER 65532:65532
ENTRYPOINT ["/aws_signing_helper"]
