# Use the current Active LTS Node.js runtime as the build image
FROM node:24.13.0-bookworm AS build

# Set the maintainer
LABEL org.opencontainers.image.source=https://github.com/labiraus/homelab

# Set the working directory in the container
WORKDIR /app

# Copy package manifests first to maximize layer caching
COPY package.json ./

# Set the maximum timeout for fetching packages to 10 minutes to avoid timeouts
# Set npm registry and configure retries to handle network issues
RUN npm config set registry https://registry.npmjs.org/ \
    && npm config set fetch-retries 5 \
    && npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 600000

# Install dependencies
RUN npm install

# Copy the entire application code to the container
COPY . .

# Build the React app for production
RUN npm run build

# Use the current Nginx alpine-slim image as the production server
FROM nginx:1.29.5-alpine3.23-slim

# Copy the built React app to Nginx's web server directory
COPY --from=build /app/dist /usr/share/nginx/html

# Expose port 8080 for the Nginx server
EXPOSE 80

# Start Nginx when the container runs
CMD ["nginx", "-g", "daemon off;"]
