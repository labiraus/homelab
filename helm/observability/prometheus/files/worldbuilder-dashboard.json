{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "worldbuilder-operations",
  "title": "Worldbuilder operations",
  "tags": [
    "worldbuilder"
  ],
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Worldbuilder requests / second",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(external_ops_total{namespace=\"$namespace\",job=\"worldbuilder-external\",method=~\"worldbuilder.*\",state=\"call\"}[5m]))",
          "legendFormat": "{{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors / second",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(external_ops_total{namespace=\"$namespace\",job=\"worldbuilder-external\",method=~\"worldbuilder.*\",state=\"error\"}[5m]))",
          "legendFormat": "{{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Conflicts, denials and allowance limits",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method,state) (rate(external_ops_total{namespace=\"$namespace\",job=\"worldbuilder-external\",method=~\"worldbuilder.*\",state=~\"conflict|denied|budget|invalid\"}[5m]))",
          "legendFormat": "{{method}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Mean request duration",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(external_processing_duration_seconds_sum{namespace=\"$namespace\",job=\"worldbuilder-external\",method=~\"worldbuilder.*\"}[5m])) / sum by (method) (rate(external_processing_duration_seconds_count{namespace=\"$namespace\",job=\"worldbuilder-external\",method=~\"worldbuilder.*\"}[5m]))",
          "legendFormat": "{{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Application namespace",
        "type": "constant",
        "query": "homelab",
        "current": {
          "text": "homelab",
          "value": "homelab"
        },
        "hide": 2
      }
    ]
  }
}
